VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional: reCAPTCHA Enterprise site key for Firebase App Check (public, like the keys above).
VITE_APPCHECK_SITE_KEY=
# Optional, dev only: App Check debug token registered in the Firebase console.
VITE_APPCHECK_DEBUG_TOKEN=
VITE_GITHUB_URL=https://github.com/HigorTuretta/play-when

# Public address of the site, without a trailing slash. Canonical links, Open Graph tags,
# the sitemap, robots.txt and shared results are built from it. Defaults to
# https://playwhen.netlify.app when empty.
VITE_PUBLIC_SITE_URL=
# Optional: Google Search Console HTML-tag verification token (only the content="..." value).
# Read at build time by scripts/prerender.mjs; it is not part of the app bundle.
GOOGLE_SITE_VERIFICATION=
# Optional: "true" also sends Analytics events for visitors who are not signed in. Leave it
# off unless the privacy policy is updated first: today it promises visitors are not tracked.
VITE_ANALYTICS_FOR_GUESTS=
